#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
# ~/.config/sketchybar/sketchybarrc
# My work flow status bar: left is space region, right is status region.
# ─────────────────────────────────────────────────────────────

CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
ITEM_DIR="$CONFIG_DIR/items"

##### Color Settings #####
source "$CONFIG_DIR/my_colors.sh"

##### Font Settings #####
FONT_ICON="Hack Nerd Font:Bold:15.0"
FONT_APP="sketchybar-app-font:Regular:17.0"
FONT_LABEL="Hack Nerd Font:Regular:13.0"   # 本机只有 Regular/Bold/Italic/BoldItalic，无 Medium（实测字体表）

##### StatusBar Height: cur is 38pt #####
NOTCH_SAFE_TOP="$(osascript -l JavaScript -e 'ObjC.import("AppKit"); ObjC.unwrap($.NSScreen.mainScreen.safeAreaInsets.top)' 2>/dev/null)"
BAR_HEIGHT="$(awk -v v="$NOTCH_SAFE_TOP" 'BEGIN{ if (v ~ /^[0-9]+(\.[0-9]+)?$/) printf "%d", v + 0.5; else print 32 }' 2>/dev/null)"
[ -z "$BAR_HEIGHT" ] && BAR_HEIGHT=32
[ "$BAR_HEIGHT" -lt 24 ] 2>/dev/null && BAR_HEIGHT=32   # 无刘海屏 → 常规高度
[ "$BAR_HEIGHT" -gt 48 ] 2>/dev/null && BAR_HEIGHT=48   # 防呆上限

##### Global Settings #####
sketchybar --bar \
    position=top \
    height=$BAR_HEIGHT \
    color=$BG_BAR \
    blur_radius=30 \
    margin=0 \
    y_offset=0 \
    padding_left=8 \
    padding_right=12 \
    notch_width=188 \
    sticky=on \
    topmost=on \
    font_smoothing=on \
    shadow=off \
    show_in_fullscreen=on \
    # border_width=2 \  # for debug
    display=main

sketchybar --default \
    padding_left=2 \
    padding_right=2 \
    icon.font="$FONT_ICON" \
    icon.color=$FG_IDLE \
    icon.padding_left=6 \
    icon.padding_right=6 \
    label.font="$FONT_LABEL" \
    label.color=$FG_LABEL \
    label.padding_left=0 \
    label.padding_right=6 \
    background.drawing=off \
    background.height=24 \
    background.corner_radius=6

##### Left: Space Region 1–5 #####

#  for more icon details: https://www.nerdfonts.com/cheat-sheet
SPACE_ROLE_ICON=("" "" "󰖟" "" "" "󰀻")
#                ^1  终端 U+E795        ^2 󰖟 浏览器 U+F059F  ^3  编程/读写 U+F0169
#                ^4  工作区 U+F017A          ^5 󰀻 其他 U+F003B   ^0 占位不用

# label 字体：模式 A（:shortcode: 连字）用 app 字体；模式 B 用 Nerd 字体。
source "$PLUGIN_DIR/my_icon_map.sh"
if [ "$ICON_MODE" = A ]; then
    SPACE_LABEL_FONT="$ICON_FONT_APP"
else
    SPACE_LABEL_FONT="$ICON_FONT_NERD"
fi

# 5 个 space item = 纯显示 + 点击
for SID in 1 2 3 4 5; do
    sketchybar --add space space.$SID left \
        --set space.$SID \
            space=$SID \
            icon="$SID${SPACE_ROLE_ICON[$SID]}" \
            icon.padding_left=8 \
            icon.padding_right=4 \
            label.drawing=off \
            label.font="$SPACE_LABEL_FONT" \
            label.padding_left=2 \
            label.padding_right=8 \
            background.drawing=on \
            background.color=$TRANSPARENT \
            script="$PLUGIN_DIR/space_click.sh" \
        --subscribe space.$SID mouse.clicked
done

# 唯一的空间事件消费者：普通 item。
# bar_manager 的 updates 开关只作用于 BAR_COMPONENT_SPACE 类型（其余 continue），
# 所以这个普通 item 能收到全部 5 个桌面的 space_windows_change；
# drawing=off 也不影响脚本执行（bar_item.c: updates_only_when_shown 默认 false）。
sketchybar --add item space.watch left \
    --set space.watch \
        drawing=off \
        updates=on \
        update_freq=0 \
        script="$PLUGIN_DIR/space_watch.sh" \
    --subscribe space.watch space_change space_windows_change


##### Right: Space region #####

# clock
sketchybar --add item clock right \
    --set clock \
        icon=󰥔 \
        icon.padding_right=4 \
        update_freq=20 \
        script="$PLUGIN_DIR/my_clock.sh"


# battery
sketchybar --add item battery right \
    --set battery \
        update_freq=60 \
        script="$PLUGIN_DIR/my_battery.sh" \
    --subscribe battery system_woke power_source_change


# inbox
sketchybar --add item inbox right \
    --set inbox \
        drawing=off \
        icon=󰇮 \
        icon.color=$RED \
        update_freq=15 \
        script="$PLUGIN_DIR/my_inbox.sh" \
    --subscribe inbox mouse.clicked


# CPU (stats_provider envents source)
killall stats_provider 2>/dev/null
sketchybar --add event system_stats 2>/dev/null

stats_provider --cpu usage --interval 2 --no-units &

sketchybar --add item cpu.percent right \
    --set cpu.percent \
        icon= \
        icon.color=$BLUE \
        label="--%" \
        update_freq=0 \
        script="$PLUGIN_DIR/my_cpu.sh" \
    --subscribe cpu.percent system_stats mouse.clicked


##### Final Setup #####
sketchybar --update
sketchybar --trigger space_change
